<Window x:Class="HandwriteInput.PoC.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字体适配"
        Width="680"
        Height="660"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="ToolWindow"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <StackPanel Margin="26">
            <TextBlock Text="字体适配" Style="{StaticResource WindowTitle}" />
            <TextBlock Text="写一段文字并校对，逐步适配你的笔迹"
                       Style="{StaticResource WindowSubtitle}" />

            <!-- 书写区 -->
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Height="240" Margin="0,18,0,0">
                <InkCanvas x:Name="Ink" Background="White" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="ClearBtn" Content="清空" Style="{StaticResource GhostButton}" Click="Clear_Click" />
                <Button x:Name="RecognizeBtn" Content="识别" Style="{StaticResource PrimaryButton}"
                        Click="Recognize_Click" Margin="10,0,0,0" />
                <TextBlock x:Name="RecogResultText" Margin="14,0,0,0" VerticalAlignment="Center"
                           FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 校对 -->
            <TextBlock Text="识别结果（可修改为正确内容）" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
            <TextBox x:Name="CorrectedBox" Height="44" FontSize="15" Margin="0,0,0,0"
                     VerticalContentAlignment="Center" TextWrapping="Wrap" />

            <!-- 底部 -->
            <Grid Margin="0,20,0,0">
                <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="{StaticResource PastelGreenFg}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="关闭" Style="{StaticResource GhostButton}" Click="Close_Click" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"
                            Margin="10,0,0,0" IsDefault="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
