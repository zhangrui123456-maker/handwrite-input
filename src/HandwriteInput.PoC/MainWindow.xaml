<Window x:Class="HandwriteInput.PoC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HandwriteInput PoC"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Grid x:Name="Root" Background="Transparent">
        <InkCanvas x:Name="InkSurface" Background="#01000000" EditingMode="Ink" />

        <Border x:Name="StatusPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#F2FFFFFF"
                BorderBrush="#EAEAEA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,8"
                Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="#2F3437"
                       FontSize="13"
                       TextWrapping="Wrap"
                       MaxWidth="720"
                       Text="正在初始化…" />
        </Border>
    </Grid>
</Window>
